# Dependencies and build output
node_modules
dist
coverage

# Local secrets (API keys). Never commit these.
.env
.env.*
*.key
*.pem

# Render caches (narration audio is cached here to avoid spending credits twice)
.cache

# Source materials must never be published. Only the documents generated by
# `npm run docs` in public/downloads/ may be committed; any other PDF, Word,
# PowerPoint, or Excel file in this folder is ignored as a safety net.
*.pdf
*.doc
*.docx
*.ppt
*.pptx
*.xls
*.xlsx
!public/downloads/**/*.pdf
!public/downloads/**/*.docx
!public/downloads/**/*.pptx

# Editors, operating systems, and local tool settings
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
.claude/settings.local.json

# Logs and temporary files
*.log
npm-debug.log*
*.tmp

# TypeScript incremental build info
*.tsbuildinfo
